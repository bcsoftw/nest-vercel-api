# Postgres (Neon, Supabase, Vercel Postgres, etc.)
# DATABASE_URL: URL con pooling (la que usa la app en runtime)
# DIRECT_URL: conexión directa (la usa Prisma para migraciones)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="1d"
